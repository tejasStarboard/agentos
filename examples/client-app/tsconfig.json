{
  "extends": "@agentos/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@extensions/*": ["./extensions/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "extensions/**/api/**/*.ts"
  ]
}
