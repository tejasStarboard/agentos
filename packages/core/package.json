{
  "name": "@agentos/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "agentos": "./bin/agentos"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./api": "./src/api/index.ts",
    "./api/*": "./src/api/lib/*.ts",
    "./vite": "./src/vite/index.ts",
    "./sdk": "./src/sdk/index.ts",
    "./shell": "./src/shell/index.ts",
    "./shell/*": "./src/shell/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@agentos/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "comlink": "^4.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "peerDependencies": {
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@agentos/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^6.3.5"
  }
}
