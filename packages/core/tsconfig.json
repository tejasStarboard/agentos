{
  "extends": "@agentos/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@agentos/core": ["./src/index.ts"],
      "@agentos/core/api/*": ["./src/api/lib/*"],
      "@agentos/core/*": ["./src/*/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "builtins/**/*.ts",
    "builtins/**/*.tsx"
  ],
  "exclude": ["dist", "node_modules"]
}
